# Local-only defaults. Use a nonempty key before exposing the service.
TW_DATA_DIR=data/service
TW_API_KEY=
TW_AUTH_MODE=bearer
TW_MAX_BODY_MIB=64
# D.1 model-check configuration. B0 Add/Search remains model-free.
DEEPSEEK_API_KEY=
TW_CHAT_PROVIDER=deepseek
TW_CHAT_BASE_URL=https://api.deepseek.com
TW_CHAT_MODEL=deepseek-flash
TW_MODEL_BUDGET_USD=5
# AML open-source evaluation will require the specified gpt-4o-mini configuration.
# OPENROUTER_API_KEY=
